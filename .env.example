# Required: Groq API key for the PDF extraction
GROQ_API_KEY=
# Optional
GROQ_MODEL=openai/gpt-oss-120b
RB_DB_PASSWORD=resumebuilder
# true when the app runs behind HTTPS (secure sign-in cookie)
COOKIE_SECURE=false
# Local development only (backend outside Docker, DB from docker compose)
DATABASE_URL=postgresql+psycopg://resumebuilder:resumebuilder@localhost:5434/resumebuilder
# Local development only: where Chromium loads the print page for the PDF download (Vite dev server)
PDF_RENDER_BASE_URL=http://localhost:5180
