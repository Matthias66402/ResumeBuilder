# Required: Groq API key for the PDF extraction
GROQ_API_KEY=

# --- Optional: everything below shows the default; uncomment to change it ---

# LLM for the PDF extraction
# GROQ_MODEL=openai/gpt-oss-120b
# Upper limit for the LLM answer incl. reasoning; too low cuts off the later resume sections.
# Groq's free tier allows 8000 tokens per minute and counts this limit up front, so prompt (~4300) + this must fit.
# GROQ_MAX_COMPLETION_TOKENS=3600
# Reasoning effort for reasoning models such as gpt-oss (low/medium/high); set it empty for models without reasoning
# GROQ_REASONING_EFFORT=low

# Password of the Postgres container
# RB_DB_PASSWORD=resumebuilder
# true when the app runs behind HTTPS (secure sign-in cookie)
# COOKIE_SECURE=false

# Local development only (backend outside Docker, DB from docker compose)
# DATABASE_URL=postgresql+psycopg://resumebuilder:resumebuilder@localhost:5434/resumebuilder
# Local development only: where Chromium loads the print page for the PDF download.
# Default is the app itself (http://127.0.0.1:8000); with the Vite dev server set it to:
# PDF_RENDER_BASE_URL=http://localhost:5180
